# Copie este archivo a .env y complete los valores.

# --- PostgreSQL (prisma.config.ts y lib/server/db.ts arman la conexión con estas variables)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nombre_base
DB_USER=usuario
DB_PASSWORD=contraseña
# Esquema donde viven las tablas (también se acepta DB_SCHEMA)
DB_SHEMA=agrosat

# --- Seed (`npm run db:seed`)
# Administrador inicial (por defecto admin@agrosat.co / demo1234)
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# "false" para no crear los productores y parcelas de demostración
# SEED_DEMO=true

# --- URL pública de la app (enlaces en los correos de alerta)
# APP_URL=https://agrosat.ejemplo.co

# --- Imágenes Landsat 8/9 (todos opcionales; por defecto Microsoft Planetary Computer)
# LANDSAT_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
# LANDSAT_COLLECTION=landsat-c2-l2
# LANDSAT_SIGN_URL=https://planetarycomputer.microsoft.com/api/sas/v1/token/landsat-c2-l2
# LANDSAT_HISTORY_FROM=2021-01-01
# % máximo de la parcela cubierta por nubes para que la fecha sea válida
# LANDSAT_MAX_PARCEL_CLOUD=50
# Escenas con más nubosidad total que esto no se descargan
# LANDSAT_MAX_SCENE_CLOUD=90
# LANDSAT_CONCURRENCY=4

# --- Tarea programada: GET /api/cron/landsat con "Authorization: Bearer <CRON_SECRET>"
# CRON_SECRET=

# --- Correo de alertas (sin SMTP_HOST los correos se registran pero no se envían)
# SMTP_HOST=smtp.ejemplo.co
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="AgroSat <alertas@agrosat.ejemplo.co>"
# Solo se avisa por correo de alertas de imágenes de los últimos N días
# ALERT_EMAIL_MAX_AGE_DAYS=24

# Token público de Mapbox para el globo de la página Satélites (https://account.mapbox.com)
NEXT_PUBLIC_MAPBOX_TOKEN=
